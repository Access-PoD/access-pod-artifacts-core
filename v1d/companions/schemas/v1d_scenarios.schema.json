{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1d_scenarios.schema.json",
  "title": "Version D Stress-Test Scenario Index",
  "description": "Small, non-normative scenario index for Version D governance stress-testing. Used to catalog scenarios and link them to stress evidence records. This schema does not define pass/fail outcomes or compliance requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1d-scenarios-1.0",
      "description": "Schema version identifier for compatibility."
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "title", "stress_types", "summary"],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "description": "Stable scenario identifier (e.g., v1d-SC-001)."
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "description": "Short scenario title."
          },
          "stress_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "authority",
                "delegation",
                "telemetry",
                "incentive",
                "ethical_ambiguity",
                "compounded"
              ]
            },
            "description": "Version D stress category tags."
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1200,
            "description": "Brief scenario summary describing what is being stressed."
          },
          "recommended_method": {
            "type": "string",
            "enum": ["tabletop", "simulation", "walkthrough", "revocation_rehearsal"],
            "description": "Optional recommended stress-testing method."
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "Optional tags for grouping."
          }
        }
      }
    }
  }
}
